{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -lc 'set -a; . \"$HOME/.config/codex-honcho-sync/.env\"; set +a; exec \"$CODEX_HONCHO_NODE\" \"$CODEX_HONCHO_SYNC_ROOT/scripts/codex_honcho_turn_gate.mjs\"'",
            "timeout": 120,
            "statusMessage": "Syncing Codex turn to Honcho"
          }
        ]
      }
    ]
  }
}
