{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
              "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"$node=$env:CODEX_HONCHO_NODE; if (-not $node) { $node=[Environment]::GetEnvironmentVariable('CODEX_HONCHO_NODE','User') }; $root=$env:CODEX_HONCHO_SYNC_ROOT; if (-not $root) { $root=[Environment]::GetEnvironmentVariable('CODEX_HONCHO_SYNC_ROOT','User') }; & $node (Join-Path $root 'scripts\\codex_honcho_turn_gate.mjs')\"",
            "timeout": 120,
            "statusMessage": "Syncing Codex turn to Honcho"
          }
        ]
      }
    ]
  }
}
