# Generated per installation. Never commit the real .env file.
POSTGRES_PASSWORD=
LLM_OPENAI_API_KEY=

# Portable defaults. A release may also include env.personal.example with the
# distributor's non-secret model topology and blank credentials.
EMBED_MESSAGES=true
EMBEDDING_MODEL_CONFIG__TRANSPORT=openai
EMBEDDING_MODEL_CONFIG__MODEL=text-embedding-3-small
EMBEDDING_VECTOR_DIMENSIONS=1536
DERIVER_MODEL_CONFIG__TRANSPORT=openai
DERIVER_MODEL_CONFIG__MODEL=gpt-5.6-sol
SUMMARY_MODEL_CONFIG__TRANSPORT=openai
SUMMARY_MODEL_CONFIG__MODEL=gpt-5.6-sol
DREAM_DEDUCTION_MODEL_CONFIG__TRANSPORT=openai
DREAM_DEDUCTION_MODEL_CONFIG__MODEL=gpt-5.6-sol
DREAM_INDUCTION_MODEL_CONFIG__TRANSPORT=openai
DREAM_INDUCTION_MODEL_CONFIG__MODEL=gpt-5.6-sol
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__MODEL=gpt-5.6-sol
DIALECTIC_LEVELS__low__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__low__MODEL_CONFIG__MODEL=gpt-5.6-sol
DIALECTIC_LEVELS__medium__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__medium__MODEL_CONFIG__MODEL=gpt-5.6-sol
DIALECTIC_LEVELS__high__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__high__MODEL_CONFIG__MODEL=gpt-5.6-sol
DIALECTIC_LEVELS__max__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__max__MODEL_CONFIG__MODEL=gpt-5.6-sol
HONCHO_API_PORT=8001
HONCHO_DASHBOARD_PORT=4173
HONCHO_IMAGE_TAG=local

AUTH_USE_AUTH=false
LOG_LEVEL=INFO

# Teammates over MCP through Cloudflare Access (COMPOSE_PROFILES=share). Set these
# only in the private .env. Until the Access team domain, audience and team MCP token
# are set, the gate answers /mcp with 404.
# HONCHO_TUNNEL_TOKEN: token of this server's remotely managed Cloudflare Tunnel, which the tunnel service runs.
# HONCHO_ACCESS_TEAM_DOMAIN: Cloudflare Zero Trust team domain (<team>.cloudflareaccess.com), whose keys sign the Access login.
# HONCHO_ACCESS_AUD: Application Audience (AUD) tag of the Access app on this server's hostname; comma-separated for several.
# HONCHO_TEAM_MCP_TOKEN: random secret the gate sends to the mcp service in place of the teammate's credentials.
# HONCHO_TEAM_WORKSPACE: Honcho workspace teammates ask (memory when unset).
# HONCHO_TEAM_PEER: Honcho peer whose memory teammates ask.
